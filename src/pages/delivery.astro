---
import Layout from '../layouts/Layout.astro';
import DeliveryDashboard from '../components/delivery/DeliveryDashboard';
---

<Layout title="Track Delivery | Abimanyu 3 Ltd" description="View delivery status and tracking details for Abimanyu 3 Ltd orders." noIndex>
	<main id="main-content" class="min-h-screen bg-[#050a18] px-6 pb-16 pt-28 text-slate-100 lg:px-8">
		<div class="mx-auto max-w-5xl">
			<DeliveryDashboard client:only="react" />
		</div>
	</main>
</Layout>

