---
import Layout from '../../layouts/Layout.astro';
import DeliveryDashboard from '../../components/delivery/DeliveryDashboard';
---

<Layout title="Dashboard | Abimanyu 3 Ltd" description="Customer dashboard for Abimanyu 3 Ltd delivery tracking." noIndex>
	<main id="main-content" class="min-h-screen bg-[#050a18] px-6 pb-16 pt-36 text-slate-100 lg:px-8">
		<div class="mx-auto max-w-5xl">
			<DeliveryDashboard client:only="react" />
		</div>
	</main>
    <script>
        import * as netlifyIdentity from 'netlify-identity-widget';
        netlifyIdentity.init();
        if (!netlifyIdentity.currentUser()) {
            window.location.assign('/login?returnTo=/account');
        }
    </script>
</Layout>
