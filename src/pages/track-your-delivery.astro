---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Track Your Delivery | Abimanyu 3 Ltd" description="Check delivery status updates for Abimanyu 3 Ltd orders. Provide your order number and buyer email to request an update.">
	<main id="main-content" class="min-h-screen bg-[#050a18] px-6 pb-16 pt-28 text-slate-100 lg:px-8">
		<div class="mx-auto max-w-2xl">
			<p class="text-xs uppercase tracking-[0.4em] text-amber-300/70">Support</p>
			<h1 class="mt-3 text-3xl font-bold text-white sm:text-4xl">Track Your Delivery</h1>
			<p class="mt-4 text-base text-slate-300">
				Enter your order details below to request an update.
			</p>

			<form
				name="track-your-delivery"
				method="POST"
				data-netlify="true"
				netlify-honeypot="bot-field"
				class="mt-10 rounded-3xl border border-white/10 bg-white/[0.03] p-6 shadow-2xl shadow-black/40"
			>
				<input type="hidden" name="form-name" value="track-your-delivery" />
				<p class="hidden">
					<label>
						Do not fill this out if you’re human: <input name="bot-field" />
					</label>
				</p>

				<div class="grid gap-6">
					<label class="grid gap-2 text-sm font-medium text-slate-200">
						<span>Order Number</span>
						<input
							name="orderNumber"
							type="text"
							required
							autocomplete="off"
							class="h-11 rounded-xl border border-white/10 bg-slate-950/40 px-4 text-slate-100 placeholder:text-slate-500 outline-none ring-0 transition focus:border-amber-400/60 focus:ring-2 focus:ring-amber-400/30"
							placeholder="e.g., A3-1024"
						/>
					</label>

					<label class="grid gap-2 text-sm font-medium text-slate-200">
						<span>Buyer Email</span>
						<input
							name="buyerEmail"
							type="email"
							required
							autocomplete="email"
							class="h-11 rounded-xl border border-white/10 bg-slate-950/40 px-4 text-slate-100 placeholder:text-slate-500 outline-none ring-0 transition focus:border-amber-400/60 focus:ring-2 focus:ring-amber-400/30"
							placeholder="name@company.com"
						/>
					</label>

					<button
						type="submit"
						class="inline-flex h-11 items-center justify-center rounded-full bg-amber-500 px-6 text-sm font-semibold text-slate-950 shadow-lg shadow-amber-500/35 transition hover:bg-amber-400"
					>
						Check Status
					</button>
				</div>

				<p class="mt-6 rounded-2xl border border-amber-400/30 bg-amber-500/10 px-4 py-3 text-sm text-amber-100">
					Your delivery status will be sent to your registered email.
				</p>
			</form>
		</div>
	</main>
</Layout>

