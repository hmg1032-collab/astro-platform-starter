];

const formatGbp = (value) =>
	new Intl.NumberFormat('en-GB', { style: 'currency', currency: 'GBP', maximumFractionDigits: 2 }).format(value);

const buildWhatsappHref = (message) => `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`;

	const packPriceFromKg = (pricePerKgGbp, grams) => Number(((pricePerKgGbp * grams) / 1000).toFixed(2));

	const buildSampleRequestMailtoHref = (product, grams) => {
		const packPriceGbp = product.samplePackPricesGbp?.[grams] ?? packPriceFromKg(product.pricePerKgGbp, grams);
		const subject = `Sample request: ${product.name} — ${product.blend} (${grams}g)`;
	const bodyLines = [
		'Hi Abimanyu team,',
		'',
		'Please send a sample for:',
		`- Product: ${product.name} (${product.blend})`,
		`- Pack size: ${grams}g`,
		`- Catalogue price: ${formatGbp(packPriceGbp)}`,
		'',
		'Delivery address:',
		'- Name:',
		'- Company:',
		'- Address:',
		'- Postcode:',
		'- Phone:',
		'',
		'Thank you.'
	];

		return `mailto:${pricingEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(bodyLines.join('\n'))}`;
	};

	const buildBuyNowWhatsappHref = (product) => {
		const packs = product.samplePackOptions ?? samplePackOptions;
		const packPriceSummary = packs
			.map((pack) => {
				const packPriceGbp = product.samplePackPricesGbp?.[pack.grams] ?? packPriceFromKg(product.pricePerKgGbp, pack.grams);
				return `${pack.label} ${formatGbp(packPriceGbp)}`;
			})
			.join(', ');

		const messageLines = [
			'Hi Abimanyu team,',
			`I would like to buy: ${product.name} (${product.blend})`,
			`Prices shown: ${packPriceSummary}`,
			'Please confirm availability, MOQ, and delivery lead time in the UK.',
			'',
			'Company name:',
			'Delivery postcode:',
		'Target volume (kg):'
	];

	return buildWhatsappHref(messageLines.join('\n'));
};

