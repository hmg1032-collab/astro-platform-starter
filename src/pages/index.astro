			pricePerKgGbp: 16,
			samplePackPricesGbp: { 100: 1.6, 250: 4.0, 500: 8.0, 1000: 16.0 },
			image: '/images/offers/premium-packet.jpg',
			imageAlt: 'Photo-style mockup of a premium coffee blend in an elegant matte black stand-up packet with refined Abimanyu 3 branding and a subtle window implying coffee powder inside.'
		}
	];

const spiceCatalogue = [
	{
		name: 'Green Cardamom',
		description: 'Aromatic, high-oil spice suited to premium blends, bakery applications, and speciality retail.',
		origin: 'India (South India; origin varies by lot).',
		qualityNotes: 'Hand-sorted grades available; moisture-managed packing with QC notes on request.'
