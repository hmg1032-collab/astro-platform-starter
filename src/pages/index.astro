---
import Layout from '../layouts/Layout.astro';

const cataloguePdfPath = '/Abimanyu3_CoffeeSpice_Catalogue_UK_2025.pdf';
const pricingEmail = 'abimanyu3wholesale@gmail.com';
const heroBackgroundImage = '/images/coffee-beans.jpg';
const whatsappNumber = '447341652445';
const whatsappPrefillText = 'Please send me the Abimanyu 3 Ltd Catalogue';
const whatsappCatalogueUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappPrefillText)}`;

const samplePackOptions = [
	{ grams: 100, label: '100g' },
	{ grams: 250, label: '250g' },
	{ grams: 500, label: '500g' },
	{ grams: 1000, label: '1kg' }
];

const formatGbp = (value) =>
	new Intl.NumberFormat('en-GB', { style: 'currency', currency: 'GBP', maximumFractionDigits: 2 }).format(value);

const buildWhatsappHref = (message) => `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`;

const packPriceFromKg = (pricePerKgGbp, grams) => Number(((pricePerKgGbp * grams) / 1000).toFixed(2));

const buildSampleRequestMailtoHref = (product, grams) => {
	const packPriceGbp = product.samplePackPricesGbp?.[grams] ?? packPriceFromKg(product.pricePerKgGbp, grams);
	const subject = `Sample request: ${product.name} — ${product.blend} (${grams}g)`;
	const bodyLines = [
		'Hi Abimanyu team,',
		'',
		'Please send a sample for:',
		`- Product: ${product.name} (${product.blend})`,
		`- Pack size: ${grams}g`,
		`- Catalogue price: ${formatGbp(packPriceGbp)}`,
		'',
		'Delivery address:',
		'- Name:',
		'- Company:',
		'- Address:',
		'- Postcode:',
		'- Phone:',
		'',
		'Thank you.'
	];

	return `mailto:${pricingEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(bodyLines.join('\n'))}`;
};

const buildBuyNowWhatsappHref = (product) => {
	const messageLines = [
		'Hi Abimanyu team,',
		`I would like to buy: ${product.name} (${product.blend})`,
		`Price shown: ${formatGbp(product.pricePerKgGbp)}/kg`,
		'Please confirm availability, MOQ, and delivery lead time in the UK.',
		'',
		'Company name:',
		'Delivery postcode:',
		'Target volume (kg):'
	];

	return buildWhatsappHref(messageLines.join('\n'));
};

const coffeeCatalogue = [
	{
		id: 'arabica-plantation-aa',
		tierLabel: 'Seasonal Offer',
		badgeClass: 'bg-amber-900/55 text-amber-100 border-amber-300/40',
		name: 'Arabica Plantation AA',
		blend: 'Fully washed lots',
		flavorNotes: 'Moisture ≤ 12%, SCAA 83+ cupping approvals.',
		pricePerKgGbp: 12,
		samplePackPricesGbp: { 100: 1.2, 250: 3.0, 500: 6.0, 1000: 12.0 },
		image: '/images/grades/arabica-aa.jpg',
		imageAlt: 'Arabica coffee beans ready for grading and packing.'
	},
	{
		id: 'robusta-cherry-ab',
		tierLabel: 'Limited Availability',
		badgeClass: 'bg-sky-900/55 text-sky-100 border-sky-300/30',
		name: 'Robusta Cherry AB',
		blend: 'Sun-dried · Screen 17+',
		flavorNotes: 'Ideal for espresso blends and instant bases.',
		pricePerKgGbp: 9,
		samplePackPricesGbp: { 100: 0.9, 250: 2.25, 500: 4.5, 1000: 9.0 },
		image: '/images/grades/robusta-ab.jpg',
		imageAlt: 'Robusta coffee cherries and beans prepared for processing.'
	},
	{
		id: 'sampler-ready-sealed-1kg',
		tierLabel: 'UK Dispatch',
		badgeClass: 'bg-slate-900/70 text-slate-100 border-slate-400/30',
		name: 'Sampler Ready – Sealed 1 kg',
		blend: 'Vacuum-packed 1 kg',
		flavorNotes: 'Vacuum-packed discovery sets couriered within the UK.',
		pricePerKgGbp: 16,
		samplePackPricesGbp: { 1000: 16.0 },
		samplePackOptions: [{ grams: 1000, label: '1kg' }],
		defaultPackGrams: 1000,
		image: '/images/grades/sampler.jpg',
		imageAlt: 'Sealed coffee sampler packs prepared for dispatch.'
	}
];

const currentOffers = coffeeCatalogue;

const spiceCatalogue = [
	{
		name: 'Green Cardamom',
		description: 'Aromatic, high-oil spice suited to premium blends, bakery applications, and speciality retail.',
		origin: 'India (South India; origin varies by lot).',
		qualityNotes: 'Hand-sorted grades available; moisture-managed packing with QC notes on request.'
	},
	{
		name: 'Black Pepper',
		description: 'Bold, clean pepper profile for foodservice and processing with consistent grind performance.',
		origin: 'India (South India; origin varies by lot).',
		qualityNotes: 'Cleaned and sorted lots available; documentation shared per shipment.'
	},
	{
		name: 'Nutmeg & Mace',
		description: 'Warm, sweet-spice notes for bakery, beverages, and culinary manufacturing.',
		origin: 'India (origin varies by lot).',
		qualityNotes: 'Whole and processed formats available; quality checks shared with samples.'
	},
	{
		name: 'Cloves',
		description: 'Rich, eugenol-forward aroma for beverages, pickling, and spice blends.',
		origin: 'India (origin varies by lot).',
		qualityNotes: 'Cleaned lots; storage and moisture guidance provided for long-haul deliveries.'
	},
	{
		name: 'Turmeric',
		description: 'Bright colour and earthy sweetness for culinary and functional product applications.',
		origin: 'India (origin varies by lot).',
		qualityNotes: 'Whole and powder formats available; QA notes shared where requested.'
	}
];

const sustainabilityCatalogue = [
	{
		name: 'Traceability & Documentation',
		description: 'Lot traceability supported with shipment-ready paperwork and QC summaries.',
		origin: 'India-to-UK supply chain (estate and lot details provided per offer).',
		qualityNotes: 'Export documents, ICO registration, and phytosanitary paperwork shared as applicable.'
	},
	{
		name: 'Sustainability-Led Sourcing',
		description: 'Sourcing prioritised through long-term estate relationships and responsible growing practices.',
		origin: 'India (estate partnerships across key growing regions).',
		qualityNotes: 'Sustainability statements and supporting paperwork provided where available.'
	},
	{
		name: 'Certifications (Where Applicable)',
		description: 'Certified lots can be offered subject to seasonal availability and customer requirements.',
		origin: 'India (certification varies by estate/lot).',
		qualityNotes: 'Certificates and scope details provided with samples and contracts when applicable.'
	}
];

const services = [
	'Direct sourcing from Rainforest Alliance aligned estates across Karnataka, Tamil Nadu, and Kerala.',
	'UK-based logistics coordination with bonded warehousing and customs-ready documentation.',
	'Custom roasting partnerships, private-label packaging, and mixed-container planning.',
	'Quality assurance with on-ground cupping labs and moisture, density, and screen grading reports.'
];

const galleryImages = [
	{
		src: '/images/coffee-cups.jpg',
		alt: 'Steaming cappuccino served in stacked white cups beside roasted coffee beans.',
		caption: 'Service-ready cappuccinos highlight the smooth body our UK clients favor.'
	},
	{
		src: '/images/coffee-beans.jpg',
		alt: 'Close-up of roasted coffee beans spilling from a burlap sack.',
		caption: 'Grade-specific green and roasted beans maintain traceability back to estate.'
	}
];
---

<Layout title="Abimanyu 3 Ltd | Indian Coffee Importer" description="Abimanyu 3 Ltd supplies speciality Indian coffee to UK roasters, cafés, and wholesalers with grades including Arabica Plantation AA and Robusta Cherry AB.">
	<main id="main-content" class="min-h-screen bg-[#050a18] text-slate-100">
		<section
			class="relative isolate overflow-hidden bg-[#050a18] bg-cover bg-center"
			style={`background-image: url('${heroBackgroundImage}')`}
		>
			<div class="absolute inset-0 bg-gradient-to-br from-[#132a4a]/90 via-[#0b1d39]/90 to-sky-900/70 pointer-events-none"></div>
			<div class="absolute inset-0 bg-slate-950/35 pointer-events-none"></div>
			<div class="absolute inset-0 opacity-20 bg-[radial-gradient(circle_at_top,_rgba(255,255,255,0.15),_transparent_50%)] pointer-events-none"></div>
			<div class="relative mx-auto flex max-w-6xl flex-col gap-12 px-6 pb-20 pt-28 md:flex-row md:items-center md:gap-16 lg:px-8">
				<div class="md:w-1/2 space-y-6">
					<div class="flex justify-center">
						<img
							src="/images/abimanyu-logo.jpg"
							alt="Abimanyu 3 Ltd logo"
							class="h-48 w-auto rounded-2xl border border-amber-500/40 bg-white/5 object-contain p-4 shadow-xl shadow-amber-500/30 sm:h-64 md:h-72 xl:h-80"
							loading="lazy"
						/>
					</div>
					<p class="uppercase tracking-[0.4em] text-xs text-amber-300/80">UK import · export · wholesale</p>
					<h1 class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl">
						Delivering speciality Indian coffee to the United Kingdom
					</h1>
					<p class="text-lg text-slate-300">
						Abimanyu 3 Ltd sources certified estates across southern India, bringing reliable, flavour-rich coffee to UK roasters, cafés, and wholesalers. Spices, teas, and allied origin produce follow through the same trusted supply chain.
					</p>
					<div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4">
						<a
							href={`mailto:${pricingEmail}`}
							class="inline-flex items-center justify-center rounded-full bg-amber-500 px-6 py-3 text-base font-semibold text-slate-950 shadow-lg shadow-amber-500/40 transition hover:bg-amber-400"
						>
							Request availability sheet
						</a>
						<a
							href="tel:+447341652445"
							class="inline-flex items-center justify-center rounded-full border border-amber-400/60 px-6 py-3 text-base font-semibold text-amber-200 transition hover:border-amber-300 hover:text-amber-100"
						>
							Call +44 7341 652445
						</a>
					</div>
					<p class="text-sm text-slate-400">
						Based in the United Kingdom with fulfilment partners across London, Birmingham, and Felixstowe.
					</p>
				</div>
				<div class="relative md:w-1/2">
					<div class="absolute -inset-6 -z-10 rounded-3xl bg-sky-400/20 blur-3xl"></div>
					<div class="rounded-3xl border border-white/10 bg-white/[0.03] p-6 shadow-2xl shadow-black/40 backdrop-blur">
						<h2 class="text-lg font-semibold text-amber-200">Spotlight Availability</h2>
						<ul class="mt-5 space-y-4 text-sm text-slate-200">
							<li class="flex items-start gap-3">
								<span class="mt-1 inline-block h-2.5 w-2.5 rounded-full bg-sky-400/80"></span>
								<span>
									<strong>Arabica Plantation AA</strong> — fully washed lots, moisture ≤ 12%, SCAA 83+ cupping approvals.
								</span>
							</li>
							<li class="flex items-start gap-3">
								<span class="mt-1 inline-block h-2.5 w-2.5 rounded-full bg-sky-400/80"></span>
								<span>
									<strong>Robusta Cherry AB</strong> — sun-dried, screen 17+, ideal for espresso blends and instant bases.
								</span>
							</li>
							<li class="flex items-start gap-3">
								<span class="mt-1 inline-block h-2.5 w-2.5 rounded-full bg-sky-400/80"></span>
								<span>
									<strong>Sampler Ready – Sealed 1 kg</strong> — vacuum-packed discovery sets couriered within the UK.
								</span>
							</li>
						</ul>
						<p class="mt-6 text-xs leading-relaxed text-slate-400">
							Export documentation, ICO registration, and phyto certificates supplied as standard. Shelf-life and roast profiles available on request.
						</p>
						<div class="mt-6 flex flex-wrap gap-3 text-sm font-semibold">
							<a
								href={`mailto:${pricingEmail}?subject=Catalogue%20Request&body=Hi%20Abimanyu%20team%2C%20please%20send%20the%20latest%20catalogue%20and%20let%20me%20know%20pricing%20for%20my%20target%20volumes.`}
								class="inline-flex items-center gap-2 rounded-full border border-amber-400/60 bg-white/5 px-4 py-2 text-amber-100 transition hover:border-amber-300 hover:bg-amber-400/10 hover:text-amber-50"
							>
								<span class="h-2.5 w-2.5 rounded-full bg-amber-400"></span>
								Email catalogue request
							</a>
							<a
								href="tel:+447341652445"
								class="inline-flex items-center gap-2 rounded-full border border-amber-400/40 px-4 py-2 text-amber-100 transition hover:border-amber-300 hover:bg-white/5 hover:text-amber-50"
							>
								<span class="h-2.5 w-2.5 rounded-full bg-sky-400"></span>
								Call +44 7341 652445
							</a>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="border-t border-white/10 bg-[#0a152a] py-16">
			<div class="mx-auto max-w-6xl px-6 lg:px-8">
				<div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
					<div class="max-w-2xl space-y-3">
						<p class="text-xs uppercase tracking-[0.4em] text-amber-300/70">Sales spotlight</p>
						<h2 class="text-3xl font-bold text-white sm:text-4xl">Current Offers</h2>
						<p class="text-base text-slate-300">
							Quick sample-pack pricing for the three grades currently featured in the availability sheet. Tap “Buy Now” to start a WhatsApp order enquiry, or request a sample by email.
						</p>
					</div>
					<div class="rounded-2xl border border-amber-400/25 bg-white/[0.03] p-4 text-sm text-slate-200 shadow-xl shadow-black/30">
						<p class="font-semibold text-white">Limited lots</p>
						<p class="mt-1 text-xs text-slate-300">Offers refresh as stock lands in the UK. Wholesale terms confirmed on request.</p>
					</div>
				</div>

				<div class="mt-10 grid gap-6 md:grid-cols-3">
					{currentOffers.map((offer) => {
						const offerPacks = offer.samplePackOptions ?? samplePackOptions;
						const buyNowHref = buildBuyNowWhatsappHref(offer);
						const requestSampleGrams = offer.defaultPackGrams ?? 250;

						return (
							<article class="group flex h-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm shadow-black/10 transition hover:-translate-y-0.5 hover:border-amber-400/70 hover:shadow-lg">
								<div class="relative">
									<img
										src={offer.image}
										alt={offer.imageAlt ?? `${offer.name} offer image`}
										loading="lazy"
										class="h-44 w-full object-cover transition duration-500 group-hover:scale-105"
									/>
									<div class="absolute inset-0 bg-gradient-to-t from-white via-white/10 to-transparent"></div>
									<span
										class={`absolute left-4 top-4 inline-flex items-center rounded-full border px-3 py-1 text-xs font-semibold ${offer.badgeClass}`}
									>
										{offer.tierLabel}
									</span>
								</div>

								<div class="flex flex-1 flex-col gap-4 p-5">
									<div class="space-y-2">
										<div class="space-y-1">
											<h3 class="text-lg font-semibold text-slate-950">{offer.name}</h3>
											<p class="text-sm font-semibold text-slate-700">{offer.blend}</p>
											<p class="text-sm text-slate-600">{offer.flavorNotes}</p>
										</div>
										<div class="flex items-end justify-between gap-4">
											<div>
												<p class="text-xs font-semibold uppercase tracking-[0.25em] text-slate-500">Price</p>
												<p class="text-3xl font-extrabold text-slate-950">
													{formatGbp(offer.pricePerKgGbp)}
													<span class="ml-1 text-sm font-semibold text-slate-500">/kg</span>
												</p>
											</div>
											<p class="text-xs text-slate-500 text-right">UK wholesale confirmation by WhatsApp or email.</p>
										</div>
									</div>

									<div class="flex flex-col gap-3 sm:flex-row">
										<a
											href={buyNowHref}
											class="inline-flex flex-1 items-center justify-center rounded-xl bg-amber-500 px-5 py-3 text-sm font-semibold text-slate-950 shadow-sm shadow-amber-500/25 transition hover:bg-amber-400"
											target="_blank"
											rel="noopener noreferrer"
										>
											Buy Now
										</a>
										<a
											href={buildSampleRequestMailtoHref(offer, requestSampleGrams)}
											class="inline-flex flex-1 items-center justify-center rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-950 transition hover:border-amber-400/70 hover:bg-amber-50"
										>
											Request Sample
										</a>
									</div>

									<div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
										<p class="text-xs font-semibold uppercase tracking-[0.25em] text-slate-600">Sample pack prices</p>
										<ul class="mt-3 grid grid-cols-2 gap-2">
											{offerPacks.map((pack) => {
												const optionPriceGbp = offer.samplePackPricesGbp?.[pack.grams] ?? packPriceFromKg(offer.pricePerKgGbp, pack.grams);
												return (
													<li class="flex items-center justify-between rounded-xl border border-slate-200 bg-white px-3 py-2">
														<span class="text-sm font-semibold text-slate-900">{pack.label}</span>
														<span class="text-sm font-semibold text-amber-800">{formatGbp(optionPriceGbp)}</span>
													</li>
												);
											})}
										</ul>
									</div>
								</div>
							</article>
						);
					})}
				</div>
			</div>
		</section>

		<section class="border-t border-white/10 bg-[#0a152a] py-16">
			<div class="mx-auto flex max-w-6xl flex-col gap-10 px-6 lg:flex-row lg:items-center lg:gap-12 lg:px-8">
				<div class="lg:w-2/5 space-y-4">
					<p class="text-xs uppercase tracking-[0.4em] text-amber-300/70">Cup quality in focus</p>
					<h2 class="text-3xl font-bold text-white sm:text-4xl">From cupping table to café counter</h2>
					<p class="text-base text-slate-300">
						Visual benchmarks reassure partners of the cup-ready consistency available through Abimanyu 3 Ltd — whether the requirement is silky arabica for espresso menus or robusta structure for blends.
					</p>
				</div>
				<div class="lg:w-3/5 grid gap-6 sm:grid-cols-2">
					{galleryImages.map((image) => (
						<figure class="group relative overflow-hidden rounded-3xl border border-white/10 bg-white/[0.02] shadow-2xl shadow-black/40">
							<img src={image.src} alt={image.alt} loading="lazy" class="h-64 w-full object-cover transition duration-500 group-hover:scale-105" />
							<figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-slate-950/90 via-slate-950/40 to-transparent px-5 pb-5 pt-16 text-sm text-slate-100">
								{image.caption}
							</figcaption>
						</figure>
					))}
				</div>
			</div>
		</section>

			<section
				id="catalogue"
				class="border-t border-white/10 bg-[#0a152a] py-20"
				data-pricing-email={pricingEmail}
				data-whatsapp-number={whatsappNumber}
			>
				<div class="mx-auto max-w-6xl px-6 lg:px-8">
					<div class="max-w-3xl">
						<p class="text-xs uppercase tracking-[0.4em] text-amber-300/70">Catalogue</p>
						<h2 class="mt-3 text-3xl font-bold text-white sm:text-4xl">Coffee, spices, and compliance — built for wholesale</h2>
					<p class="mt-4 text-base text-slate-300">
						Shop coffee grades with clear pack sizes and visible catalogue pricing. Bulk wholesale pricing and lot details are confirmed on request.
					</p>
						<div class="mt-8 rounded-2xl border border-amber-400/30 bg-white/[0.03] p-6 text-sm text-slate-200 shadow-xl shadow-black/30">
							<p class="font-semibold text-white">Pricing & catalogue requests</p>
							<p class="mt-2 leading-relaxed text-slate-300">
								For pricing and catalogue requests, please contact us at <a class="text-amber-200 underline decoration-amber-400/40 underline-offset-4" href={`mailto:${pricingEmail}`}>{pricingEmail}</a>.
								Prices shown below are per-kg prices with sample packs (100g, 250g, 500g, 1kg) listed clearly for quick ordering.
							</p>
							<div class="mt-5 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
								<a
									href={cataloguePdfPath}
									class="inline-flex items-center justify-center rounded-full bg-amber-500 px-6 py-3 text-sm font-semibold text-slate-950 shadow-lg shadow-amber-500/35 transition hover:bg-amber-400"
								download
							>
								Download Catalogue
							</a>
							<a
								href={whatsappCatalogueUrl}
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex items-center justify-center rounded-full border border-amber-400/60 px-6 py-3 text-sm font-semibold text-amber-100 transition hover:border-amber-300 hover:bg-white/5 hover:text-amber-50"
							>
								Get Catalogue on WhatsApp
							</a>
						</div>
						<p class="mt-4 text-xs text-slate-400">
							Note: WhatsApp auto-replies are configured in the WhatsApp Business account settings.
						</p>
					</div>

				</div>

				<div class="mx-auto mt-16 max-w-6xl px-6 lg:px-8">
					<div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
						<div>
							<p class="text-xs uppercase tracking-[0.4em] text-amber-300/70">Product catalogue</p>
							<h3 class="mt-2 text-2xl font-semibold text-white">Coffee offers</h3>
						</div>
						<p class="text-xs text-slate-400">Three options with visible per-kg and sample-pack pricing.</p>
					</div>

					<div class="mt-8 flex flex-col gap-3 rounded-2xl border border-white/10 bg-white/[0.02] p-5 shadow-xl shadow-black/20 sm:flex-row sm:items-center sm:justify-between">
						<div class="space-y-1">
							<p class="text-sm font-semibold text-white">Sample packs & quick ordering</p>
							<p class="text-xs text-slate-300">Choose a pack size on any product, then add to cart or request a sample.</p>
						</div>
						<div class="flex flex-wrap items-center gap-3">
							<button
								id="open-cart"
								type="button"
								class="inline-flex items-center justify-center gap-2 rounded-full border border-amber-400/60 bg-white/5 px-5 py-2 text-sm font-semibold text-amber-100 transition hover:border-amber-300 hover:bg-white/10"
							>
								Cart
								<span id="cart-count" class="inline-flex min-w-7 items-center justify-center rounded-full bg-amber-500 px-2 py-0.5 text-xs font-bold text-slate-950">0</span>
							</button>
							<a
								href={whatsappCatalogueUrl}
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex items-center justify-center rounded-full bg-amber-500 px-5 py-2 text-sm font-semibold text-slate-950 shadow-lg shadow-amber-500/30 transition hover:bg-amber-400"
							>
								Order help on WhatsApp
							</a>
						</div>
					</div>

					<div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-3">
						{coffeeCatalogue.map((product) => (
							<article
								id={product.id}
								class="group flex h-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-md shadow-black/10 transition hover:-translate-y-1 hover:border-amber-400/70 hover:shadow-xl"
							>
