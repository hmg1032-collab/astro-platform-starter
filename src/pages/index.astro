---
import Layout from '../layouts/Layout.astro';

const cataloguePdfPath = '/Abimanyu3_CoffeeSpice_Catalogue_UK_2025.pdf';
const pricingEmail = 'abimanyu3wholesale@gmail.com';
const websiteDisplay = 'www.abimanyu3wholesale.com';
const heroBackgroundImage = '/images/coffee-beans.jpg';
const festiveSpiceImage = '/images/samples/pepper-jar-real.png';
const festiveCoffeeSampleImage = '/images/samples/coffee-jar-real.png';
const whatsappNumber = '447341652445';
const whatsappPrefillText = 'Please send me the Abimanyu 3 Ltd Catalogue';
const whatsappCatalogueUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappPrefillText)}`;

const services = [
	'Direct sourcing from Rainforest Alliance aligned estates across Karnataka, Tamil Nadu, and Kerala.',
	'UK-based logistics coordination with bonded warehousing and customs-ready documentation.',
	'Custom roasting partnerships, private-label packaging, and mixed-container planning.',
	'Quality assurance with on-ground cupping labs and moisture, density, and screen grading reports.'
];

const galleryImages = [
	{
		src: '/images/coffee-cups.jpg',
		alt: 'Steaming cappuccino served in stacked white cups beside roasted coffee beans.',
		caption: 'Service-ready cappuccinos highlight the smooth body our UK clients favor.'
	},
	{
		src: '/images/coffee-beans.jpg',
		alt: 'Close-up of roasted coffee beans spilling from a burlap sack.',
		caption: 'Grade-specific green and roasted beans maintain traceability back to estate.'
	}
];
---

<Layout title="Abimanyu 3 Ltd | Indian Coffee Importer" description="Abimanyu 3 Ltd supplies speciality Indian coffee to UK roasters, cafés, and wholesalers with grades including Arabica Plantation AA and Robusta Cherry AB.">
	<main id="main-content" class="min-h-screen bg-[#050a18] text-slate-100">
		<section
			class="relative isolate overflow-hidden bg-[#050a18] bg-cover bg-center"
			style={`background-image: url('${heroBackgroundImage}')`}
		>
			<div class="absolute inset-0 bg-gradient-to-br from-slate-950/90 via-slate-900/80 to-slate-950/90 pointer-events-none"></div>
			<div class="absolute inset-0 bg-slate-950/40 pointer-events-none"></div>
			<div class="absolute inset-0 opacity-20 bg-[radial-gradient(circle_at_top,_rgba(255,255,255,0.15),_transparent_50%)] pointer-events-none"></div>
			<div class="relative z-10 mx-auto flex max-w-6xl flex-col gap-12 px-6 pb-20 pt-36 md:flex-row md:items-start md:gap-16 lg:px-8">
				<div class="md:w-1/2 space-y-6">
					<p class="uppercase tracking-[0.4em] text-xs text-amber-200/90">UK import · export · wholesale</p>
						<h1 class="text-5xl font-extrabold leading-[0.95] tracking-tight text-white sm:text-6xl lg:text-7xl">
							Premium Indian Coffee &amp; Spices for UK Roasters and Wholesalers.
						</h1>
						<p class="text-lg text-slate-200">
							Direct trade sourcing from Karnataka estates to UK bonded warehousing.
						</p>
						
						<div class="flex flex-wrap items-center gap-3 text-amber-100/90">
							<a
								href="#spice-portfolio"
								class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-semibold transition hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-amber-400/50"
							>
								<svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4 text-amber-200">
									<path
										fill="currentColor"
										d="M9 2h6l1 3h-8l1-3Zm-2.5 5h11c1 0 1.8.8 1.8 1.8v2.2c0 1-1 1.8-2 1.8H6.7c-1 0-2-.8-2-1.8V8.8C4.7 7.8 5.5 7 6.5 7Zm-1.8 6h14.6l-1.4 8.4c-.2 1-1 1.6-2 1.6H8.1c-1 0-1.8-.7-2-1.6L4.7 13Z"
									/>
									</svg>
								Pepper jar samples
							</a>
							<a
								href="#catalogue"
								class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-semibold transition hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-amber-400/50"
							>
								<svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4 text-amber-200">
									<path fill="currentColor" d="M6 2h12v4H6V2Zm1 6h10l-1 14H8L7 8Zm3 3h4v2h-4v-2Z" />
								</svg>
								Coffee &amp; spice samples
							</a>
						</div>

						<div class="flex flex-col justify-center gap-3 sm:items-start pt-4">
							<a
								href="#catalogue"
								class="inline-flex w-full items-center justify-center rounded-full bg-amber-500 px-6 py-3 text-base font-semibold text-slate-950 shadow-lg shadow-amber-500/30 transition hover:bg-amber-400 sm:w-auto"
							>
								View Catalogue
							</a>
							<a
								href={`mailto:${pricingEmail}`}
								class="inline-flex w-full items-center justify-center rounded-full border border-amber-400/60 bg-white/5 px-6 py-3 text-base font-semibold text-amber-100 transition hover:border-amber-300 hover:bg-white/10 hover:text-amber-50 sm:w-auto"
							>
								Request availability sheet
							</a>
							<a
								href="tel:+447341652445"
								class="text-sm font-semibold text-amber-200 underline decoration-amber-400/40 underline-offset-4 transition hover:text-amber-100"
							>
								Call +44 7341 652445
							</a>
						</div>

						<div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs font-semibold text-amber-100/90 pt-4">
							<a
								href="/"
								class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1 transition hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-amber-400/50"
							>
								<svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4 text-amber-200">
									<path
										fill="currentColor"
										d="M12 2 3 10h2v10h6v-6h2v6h6V10h2L12 2Zm0 3.2 6 5.2v7.6h-3v-6H9v6H6v-7.6l6-5.2Z"
									/>
								</svg>
								{websiteDisplay}
							</a>
							<a
								href={`mailto:${pricingEmail}`}
								class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1 transition hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-amber-400/50"
							>
								<svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4 text-amber-200">
									<path
										fill="currentColor"
										d="M4 6.5A2.5 2.5 0 0 1 6.5 4h11A2.5 2.5 0 0 1 20 6.5v11A2.5 2.5 0 0 1 17.5 20h-11A2.5 2.5 0 0 1 4 17.5v-11Zm2.4-.5 5.6 4.2 5.6-4.2H6.4Zm11.6 2.2-6 4.5-6-4.5v9.3c0 .7.6 1.3 1.3 1.3h9.4c.7 0 1.3-.6 1.3-1.3V8.2Z"
									/>
								</svg>
								{pricingEmail}
							</a>
							<a
								href="tel:+447341652445"
								class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1 transition hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-amber-400/50"
							>
								<svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4 text-amber-200">
									<path
										fill="currentColor"
										d="M7 2h3l1 5-2 1c1.2 2.6 3.3 4.7 5.9 5.9l1-2 5 1v3c0 1.1-.9 2-2 2h-1c-8.3 0-15-6.7-15-15V4c0-1.1.9-2 2-2Z"
									/>
								</svg>
								+44 7341 652445
							</a>
						</div>
						<p class="text-sm text-slate-400">
							Based in the United Kingdom with fulfilment partners across London, Birmingham, and Felixstowe.
						</p>
					</div>
				<div class="relative md:w-1/2 space-y-6">
					<div class="absolute -inset-6 -z-10 rounded-3xl bg-amber-400/10 blur-3xl"></div>
					<div class="mx-auto grid w-full max-w-xl gap-6 md:grid-cols-2">
						<figure class="flex flex-col overflow-hidden rounded-3xl border border-white/10 bg-white/[0.03] shadow-2xl shadow-black/40 backdrop-blur">
							<div class="relative h-52 w-full bg-white">
									<img
										src={festiveSpiceImage}
										alt="Pepper sample jar"
										class="h-full w-full object-contain object-center p-4"
										loading="lazy"
										decoding="async"
									/>
								<div class="pointer-events-none absolute inset-x-0 bottom-4 flex justify-center">
									<span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-slate-950/70 px-2.5 py-1 text-[11px] font-semibold tracking-wide text-slate-100 shadow-lg backdrop-blur">
										<img
											src="/images/abimanyu-logo.jpg"
											alt=""
											class="h-5 w-5 rounded-full border border-amber-400/50 bg-white/5 object-cover"
											loading="lazy"
											decoding="async"
										/>
										Abimanyu 3
									</span>
								</div>
								</div>
								<figcaption class="mt-auto px-5 py-4 text-sm text-amber-50">
									<span class="font-semibold text-amber-200">Pepper samples</span> shown in a simple, retail-ready jar format.
								</figcaption>
							</figure>
							<figure class="flex flex-col overflow-hidden rounded-3xl border border-white/10 bg-white/[0.03] shadow-2xl shadow-black/40 backdrop-blur">
								<div class="relative h-52 w-full bg-white">
									<img
										src={festiveCoffeeSampleImage}
										alt="Coffee sample jar"
										class="h-full w-full object-contain object-center p-4"
										loading="lazy"
										decoding="async"
									/>
								<div class="pointer-events-none absolute inset-x-0 bottom-4 flex justify-center">
									<span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-slate-950/70 px-2.5 py-1 text-[11px] font-semibold tracking-wide text-slate-100 shadow-lg backdrop-blur">
										<img
											src="/images/abimanyu-logo.jpg"
											alt=""
											class="h-5 w-5 rounded-full border border-amber-400/50 bg-white/5 object-cover"
											loading="lazy"
											decoding="async"
										/>
										Abimanyu 3
									</span>
								</div>
								</div>
								<figcaption class="mt-auto px-5 py-4 text-sm text-amber-50">
									<span class="font-semibold text-amber-200">Coffee jar samples</span> sealed and courier-ready for UK roasters.
								</figcaption>
							</figure>
						</div>
					<div class="rounded-3xl border border-white/10 bg-white/[0.03] p-6 shadow-2xl shadow-black/40 backdrop-blur">
						<h2 class="text-lg font-semibold text-amber-200">Spotlight Availability</h2>
						<ul class="mt-5 space-y-4 text-sm text-slate-200">
							<li class="flex items-start gap-3">
								<span class="mt-1 inline-block h-2.5 w-2.5 rounded-full bg-amber-400/80"></span>
								<span>
									<strong>Arabica Plantation AA</strong> — fully washed lots, moisture ≤ 12%, SCAA 83+ cupping approvals.
								</span>
							</li>
							<li class="flex items-start gap-3">
								<span class="mt-1 inline-block h-2.5 w-2.5 rounded-full bg-amber-400/80"></span>
								<span>
									<strong>Robusta Cherry AB</strong> — sun-dried, screen 17+, ideal for espresso blends and instant bases.
								</span>
							</li>
							<li class="flex items-start gap-3">
								<span class="mt-1 inline-block h-2.5 w-2.5 rounded-full bg-amber-400/80"></span>
								<span>
										<strong>Sampler Ready – Sealed 1 kg</strong> — sealed sample jars prepared for quick cupping and roast trials in the UK.
									</span>
								</li>
						</ul>
						<p class="mt-6 text-xs leading-relaxed text-slate-400">
							Export documentation, ICO registration, and phyto certificates supplied as standard. Shelf-life and roast profiles available on request.
						</p>
						<div class="mt-6 flex flex-wrap gap-3 text-sm font-semibold">
							<a
								href={`mailto:${pricingEmail}?subject=Catalogue%20Request&body=Hi%20Abimanyu%20team%2C%20please%20send%20the%20latest%20catalogue%20and%20let%20me%20know%20pricing%20for%20my%20target%20volumes.`}
								class="inline-flex items-center gap-2 rounded-full border border-amber-400/60 bg-white/5 px-4 py-2 text-amber-100 transition hover:border-amber-300 hover:bg-amber-400/10 hover:text-amber-50"
							>
								<span class="h-2.5 w-2.5 rounded-full bg-amber-400"></span>
								Email catalogue request
							</a>
							<a
								href="tel:+447341652445"
								class="inline-flex items-center gap-2 rounded-full border border-amber-400/40 px-4 py-2 text-amber-100 transition hover:border-amber-300 hover:bg-white/5 hover:text-amber-50"
							>
								<span class="h-2.5 w-2.5 rounded-full bg-amber-400"></span>
								Call +44 7341 652445
							</a>
						</div>
					</div>
				</div>
			</div>
		</section>



		<section class="border-t border-white/10 bg-[#0a152a] py-16">
			<div class="mx-auto flex max-w-6xl flex-col gap-10 px-6 lg:flex-row lg:items-center lg:gap-12 lg:px-8">
				<div class="lg:w-2/5 space-y-4">
					<p class="text-xs uppercase tracking-[0.4em] text-amber-300/70">Cup quality in focus</p>
					<h2 class="text-3xl font-bold text-white sm:text-4xl">From cupping table to café counter</h2>
					<p class="text-base text-slate-300">
						Visual benchmarks reassure partners of the cup-ready consistency available through Abimanyu 3 Ltd — whether the requirement is silky arabica for espresso menus or robusta structure for blends.
					</p>
				</div>
				<div class="lg:w-3/5 grid gap-6 sm:grid-cols-2">
					{galleryImages.map((image) => (
						<figure class="group relative overflow-hidden rounded-3xl border border-white/10 bg-white/[0.02] shadow-2xl shadow-black/40">
							<img src={image.src} alt={image.alt} loading="lazy" class="h-64 w-full object-cover transition duration-500 group-hover:scale-105" />
							<figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-slate-950/90 via-slate-950/40 to-transparent px-5 pb-5 pt-16 text-sm text-slate-100">
								{image.caption}
							</figcaption>
						</figure>
					))}
				</div>
			</div>
		</section>

			<section id="catalogue" class="border-t border-white/10 bg-[#0a152a] py-20">
				<div class="mx-auto max-w-4xl px-6 text-center lg:px-8">
					<h2 class="text-3xl font-bold text-white sm:text-4xl">Wholesale Catalogue</h2>
					<p class="mt-4 text-lg text-slate-300">
						Our full catalogue of premium coffee and spices is available exclusively to registered wholesale partners.
					</p>
					<div class="mt-8 flex justify-center gap-4">
						<a href="/login" class="rounded-full bg-amber-500 px-8 py-3 text-base font-semibold text-slate-950 shadow-lg hover:bg-amber-400 transition">
							Log In to View Catalogue
						</a>
						<a href="/signup" class="rounded-full border border-amber-400/60 px-8 py-3 text-base font-semibold text-amber-100 hover:bg-white/5 transition">
							Create Account
						</a>
					</div>
				</div>
			</section>

			<section id="delivery-payment" class="border-t border-white/10 bg-[#0a152a] py-20">
				<div class="mx-auto max-w-6xl px-6 lg:px-8">
					<div class="max-w-3xl">
						<p class="text-xs uppercase tracking-[0.4em] text-amber-300/70">Delivery & Payment</p>
						<h2 class="mt-3 text-3xl font-bold text-white sm:text-4xl">Clear delivery terms and flexible payment options</h2>
						<p class="mt-4 text-base text-slate-300">
							Delivery and payment are agreed per order based on shipment size, timeline, and destination requirements.
						</p>
					</div>

					<div class="mt-10 grid gap-8 lg:grid-cols-2">
						<article class="rounded-2xl border border-white/10 bg-white/[0.03] p-7 text-sm text-slate-200 shadow-xl shadow-black/25">
							<h3 class="text-xl font-semibold text-white">Delivery</h3>
							<ul class="mt-5 space-y-3 text-slate-300">
								<li>
									<strong class="text-slate-100">Samples:</strong> Delivered via DHL/FedEx; courier costs are borne by the buyer unless otherwise agreed.
								</li>
								<li>
									<strong class="text-slate-100">Bulk orders:</strong> Shipped FOB (Free on Board) India or CIF (Cost, Insurance, Freight) to UK ports.
								</li>
								<li>
									<strong class="text-slate-100">Lead time:</strong> 2–4 weeks from order confirmation and receipt of payment or an active Letter of Credit (LOC).
								</li>
								<li>
									<strong class="text-slate-100">Documentation:</strong> Invoice, Packing List, Bill of Lading, FSSAI, IEC, and any buyer-requested certificates.
								</li>
								<li>
									<strong class="text-slate-100">Flexibility:</strong> Buyers can choose air freight (faster, higher cost) or sea freight (economical, longer transit).
								</li>
							</ul>
						</article>

						<article class="rounded-2xl border border-white/10 bg-white/[0.03] p-7 text-sm text-slate-200 shadow-xl shadow-black/25">
							<h3 class="text-xl font-semibold text-white">Payment & pricing</h3>
								<ul class="mt-5 space-y-3 text-slate-300">
									<li>
										<strong class="text-slate-100">Bank transfer:</strong> Payments accepted in GBP (£) only.
									</li>
								<li>
									<strong class="text-slate-100">Advance payment:</strong> 50–70% upfront for standard orders; balance due before shipment.
								</li>
								<li>
									<strong class="text-slate-100">Letter of Credit (LOC):</strong> Available for larger contracts, subject to issuing bank approval. LOC transactions are secured through the buyer’s bank guarantee and are recommended for bulk shipments and long-term contracts.
								</li>
								<li>
									<strong class="text-slate-100">Samples:</strong> 100% courier cost is borne by the buyer.
								</li>
									<li>
										<strong class="text-slate-100">Currency handling:</strong> All invoices are issued in GBP (£) with no hidden charges.
									</li>
								</ul>

							<div class="mt-6 rounded-xl border border-amber-400/30 bg-amber-500/10 p-5">
								<p class="font-semibold text-white">Pricing policy</p>
								<p class="mt-2 leading-relaxed text-slate-200">
									Prices are not displayed on the website. For pricing and catalogue requests, please contact us at <a class="text-amber-200 underline decoration-amber-400/40 underline-offset-4" href={`mailto:${pricingEmail}`}>{pricingEmail}</a>.
								</p>
							</div>
						</article>
					</div>
				</div>
			</section>

			<section class="border-t border-white/10 bg-[#0a152a] py-20">
				<div class="mx-auto grid max-w-6xl gap-12 px-6 lg:grid-cols-5 lg:px-8">
					<div class="lg:col-span-2">
						<p class="text-xs uppercase tracking-[0.4em] text-amber-300/70">How the team supports growth</p>
						<h2 class="mt-3 text-3xl font-bold text-white sm:text-4xl">
						End-to-end sourcing, compliance, and flavour stewardship
					</h2>
					<p class="mt-4 text-base text-slate-300">
						The Abimanyu 3 Ltd supply chain blends on-ground estate relationships in India with UK-based fulfilment expertise, ensuring predictable arrivals, quality control, and responsive customer service.
					</p>
				</div>
				<div class="lg:col-span-3">
					<ul class="grid gap-6 sm:grid-cols-2">
						{services.map((service) => (
							<li class="rounded-2xl border border-white/5 bg-white/[0.02] p-6 text-sm text-slate-200 shadow-lg shadow-black/30">
								{service}
							</li>
						))}
					</ul>
				</div>
			</div>
		</section>

			<section id="contact" class="border-t border-white/10 bg-gradient-to-br from-red-950 via-amber-950/55 to-rose-900/60 py-20">
				<div class="mx-auto max-w-4xl px-6 text-center lg:px-8">
					<h2 class="text-3xl font-bold text-white sm:text-4xl">Let's plan your next shipment</h2>
					<p class="mt-4 text-base text-slate-300">
						Share your roast profile targets, preferred grades, and delivery timelines. The team responds within one UK business day with availability, samples, and logistics options.
					</p>
					<div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
						<a
							href="/"
							class="inline-flex items-center justify-center rounded-full border border-amber-400/60 px-6 py-3 text-base font-semibold text-amber-100 transition hover:border-amber-300 hover:bg-white/5 hover:text-amber-50"
						>
							{websiteDisplay}
						</a>
						<a
							href={`mailto:${pricingEmail}`}
							class="inline-flex items-center justify-center rounded-full bg-amber-500 px-6 py-3 text-base font-semibold text-slate-950 shadow-lg shadow-amber-500/40 transition hover:bg-amber-400"
						>
							{pricingEmail}
						</a>
					<a
						href="tel:+447341652445"
						class="inline-flex items-center justify-center rounded-full border border-amber-400/60 px-6 py-3 text-base font-semibold text-amber-100 transition hover:border-amber-300 hover:text-amber-50"
					>
						+44 7341 652445
					</a>
				</div>
				<p class="mt-6 text-xs uppercase tracking-[0.3em] text-amber-200/70">Company No. — Abimanyu 3 Ltd · United Kingdom</p>
			</div>

			<div class="mx-auto mt-14 max-w-4xl px-6 lg:px-8">
				<div class="rounded-3xl border border-white/10 bg-white/[0.03] p-8 shadow-2xl shadow-black/40">
					<h3 class="text-2xl font-semibold text-white">Delivery Queries</h3>
					<p class="mt-3 text-sm leading-relaxed text-slate-300">
						For delivery tracking or further queries, please email us at
						<a class="text-amber-200 underline decoration-amber-400/40 underline-offset-4" href={`mailto:${pricingEmail}`}>{pricingEmail}</a>.
					</p>

					<form
						name="delivery-queries"
						method="POST"
						data-netlify="true"
						netlify-honeypot="bot-field"
						class="mt-8 grid gap-5"
					>
						<input type="hidden" name="form-name" value="delivery-queries" />
						<input type="hidden" name="subject" value="Abimanyu 3 Ltd – Delivery Query Received" />
						<p class="hidden">
							<label>
								Do not fill this out if you’re human: <input name="bot-field" />
							</label>
						</p>

						<div class="grid gap-4 sm:grid-cols-2">
							<label class="grid gap-2 text-sm font-medium text-slate-200">
								<span>Order Number</span>
								<input
									name="orderNumber"
									type="text"
									autocomplete="off"
									class="h-11 rounded-xl border border-white/10 bg-slate-950/40 px-4 text-slate-100 placeholder:text-slate-500 outline-none ring-0 transition focus:border-amber-400/60 focus:ring-2 focus:ring-amber-400/30"
									placeholder="e.g., A3-1024"
								/>
							</label>
							<label class="grid gap-2 text-sm font-medium text-slate-200">
								<span>Buyer Email</span>
								<input
									name="email"
									type="email"
									required
									autocomplete="email"
									class="h-11 rounded-xl border border-white/10 bg-slate-950/40 px-4 text-slate-100 placeholder:text-slate-500 outline-none ring-0 transition focus:border-amber-400/60 focus:ring-2 focus:ring-amber-400/30"
									placeholder="name@company.com"
								/>
							</label>
						</div>

						<label class="grid gap-2 text-sm font-medium text-slate-200">
							<span>Query</span>
							<textarea
								name="message"
								rows="4"
								required
								class="rounded-xl border border-white/10 bg-slate-950/40 px-4 py-3 text-slate-100 placeholder:text-slate-500 outline-none ring-0 transition focus:border-amber-400/60 focus:ring-2 focus:ring-amber-400/30"
								placeholder="Share your delivery question here."
							></textarea>
						</label>

						<button
							type="submit"
							class="inline-flex h-11 items-center justify-center rounded-full bg-amber-500 px-6 text-sm font-semibold text-slate-950 shadow-lg shadow-amber-500/35 transition hover:bg-amber-400"
						>
							Send Delivery Query
						</button>
					</form>

					<p class="mt-4 text-xs text-slate-400">
						An acknowledgement email can be enabled via Netlify Forms autoresponder settings for this form.
					</p>
				</div>
			</div>
		</section>

		<footer class="border-t border-white/10 bg-[#040d18] py-8">
			<div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-6 text-sm text-slate-500 sm:flex-row lg:px-8">
				<p>© {new Date().getFullYear()} Abimanyu 3 Ltd. All rights reserved.</p>
				<p>Import · Export · Wholesale Coffee & Commodities</p>
			</div>
		</footer>
	</main>
</Layout>
