---
import Layout from '../layouts/Layout.astro';

const cataloguePdfPath = '/Abimanyu3_CoffeeSpice_Catalogue_UK_2025.pdf';
const pricingEmail = 'abimanyu3wholesale@gmail.com';
const whatsappNumber = '447341652445';
const whatsappPrefillText = 'Please send me the Abimanyu 3 Ltd Catalogue';
const whatsappCatalogueUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappPrefillText)}`;

const coffeeCatalogue = [
	{
		name: 'Arabica Plantation AA',
		format: 'Green / Roasted',
		description: 'Shade-grown arabica curated for clean cups with citrus brightness and a silky body.',
		origin: 'India (Western Ghats; estate- and lot-traceable).',
		qualityNotes: 'Fully washed; moisture managed to export spec; QC documentation available per shipment.',
		image: '/images/grades/arabica-aa.jpg',
		imageAlt: 'Arabica coffee leaves and cherries on a branch with morning dew.'
	},
	{
		name: 'Robusta Cherry AB',
		format: 'Green / Roasted',
		description: 'Sun-dried robusta delivering creamy crema, chocolate depth, and strong blending structure.',
		origin: 'India (South India; lot origins shared with samples).',
		qualityNotes: 'Screen and moisture controls applied; suitable for espresso blends and instant bases.',
		image: '/images/grades/robusta-ab.jpg',
		imageAlt: 'Close-up of ripe coffee cherries clustered together on the branch.'
	},
	{
		name: 'Sampler Ready – Sealed 1 kg',
		format: 'Green / Roasted',
		description: 'Vacuum-sealed discovery packs for roaster evaluation and menu development.',
		origin: 'UK-packed from current-lot inventory (origins stated on pack).',
		qualityNotes: 'Shelf-stable, courier-ready; ideal for cupping, trial roasts, and QC sign-off.',
		image: '/images/grades/sampler.jpg',
		imageAlt: 'Coffee packaging and sample bags arranged on a countertop.'
	},
	{
		name: 'Mysore Nuggets Extra Bold',
		format: 'Green / Roasted',
		description: 'Premium arabica with extra-large screen sizing and cocoa-sweet clarity for espresso blends.',
		origin: 'India (Karnataka; estate-linked supply).',
		qualityNotes: 'Extra-bold screen selections; moisture stabilised; consistent density for repeat roasts.',
		image: '/images/grades/mysore-nuggets.jpg',
		imageAlt: 'Roasted coffee beans spilling from a burlap sack.'
	},
	{
		name: 'Arabica Plantation PB',
		format: 'Green / Roasted',
		description: 'Peaberry selections offering bright acidity and citrus clarity for lively single origins.',
		origin: 'India (estate-specific lots; full traceability provided).',
		qualityNotes: 'Density and size graded; packed export-ready with QC reporting available.',
		image: '/images/grades/plantation-pb.jpg',
		imageAlt: 'Coffee cherries turning red on a plantation branch.'
	},
	{
		name: 'Monsooned Malabar AA',
		format: 'Green / Roasted',
		description: 'Low-acid, mellow-bodied monsooned profile delivering crema weight and spice-laced sweetness.',
		origin: 'India (Malabar Coast; monsooning lots documented by season).',
		qualityNotes: 'AA screen selections; moisture and colour tracking; documentation supplied per container.',
		image: '/images/grades/monsooned-malabar.jpg',
		imageAlt: 'Stacks of coffee sacks inside a warehouse with warm light.'
	},
	{
		name: 'Robusta Cherry C',
		format: 'Green / Roasted',
		description: 'Value robusta offering strong crema support and cocoa bitterness for commercial blends.',
		origin: 'India (South India; origin details shared per lot).',
		qualityNotes: 'Sun-dried and uniform; shipped with standard export documentation.',
		image: '/images/grades/robusta-c.jpg',
		imageAlt: 'Coffee beans drying on a raised bed under sunlight.'
	},
	{
		name: 'Organic Estate Microlots (Coorg, Chikmagalur)',
		format: 'Green / Roasted',
		description: 'Traceable microlots with floral top-notes and spice complexity for boutique roasters.',
		origin: 'India (Coorg & Chikmagalur).',
		qualityNotes: 'Certification and lot paperwork supplied where applicable; limited seasonal availability.',
		image: '/images/grades/organic-estate.jpg',
		imageAlt: 'Ripe coffee cherries on a Chikkamagalur estate tree canopy with natural shade.'
	}
];

const spiceCatalogue = [
	{
		name: 'Green Cardamom',
		description: 'Aromatic, high-oil spice suited to premium blends, bakery applications, and speciality retail.',
		origin: 'India (South India; origin varies by lot).',
		qualityNotes: 'Hand-sorted grades available; moisture-managed packing with QC notes on request.'
	},
	{
		name: 'Black Pepper',
		description: 'Bold, clean pepper profile for foodservice and processing with consistent grind performance.',
		origin: 'India (South India; origin varies by lot).',
		qualityNotes: 'Cleaned and sorted lots available; documentation shared per shipment.'
	},
	{
		name: 'Nutmeg & Mace',
		description: 'Warm, sweet-spice notes for bakery, beverages, and culinary manufacturing.',
		origin: 'India (origin varies by lot).',
		qualityNotes: 'Whole and processed formats available; quality checks shared with samples.'
	},
	{
		name: 'Cloves',
		description: 'Rich, eugenol-forward aroma for beverages, pickling, and spice blends.',
		origin: 'India (origin varies by lot).',
		qualityNotes: 'Cleaned lots; storage and moisture guidance provided for long-haul deliveries.'
	},
	{
		name: 'Turmeric',
		description: 'Bright colour and earthy sweetness for culinary and functional product applications.',
		origin: 'India (origin varies by lot).',
		qualityNotes: 'Whole and powder formats available; QA notes shared where requested.'
	}
];

const sustainabilityCatalogue = [
	{
		name: 'Traceability & Documentation',
		description: 'Lot traceability supported with shipment-ready paperwork and QC summaries.',
		origin: 'India-to-UK supply chain (estate and lot details provided per offer).',
		qualityNotes: 'Export documents, ICO registration, and phytosanitary paperwork shared as applicable.'
	},
	{
		name: 'Sustainability-Led Sourcing',
		description: 'Sourcing prioritised through long-term estate relationships and responsible growing practices.',
		origin: 'India (estate partnerships across key growing regions).',
		qualityNotes: 'Sustainability statements and supporting paperwork provided where available.'
	},
	{
		name: 'Certifications (Where Applicable)',
		description: 'Certified lots can be offered subject to seasonal availability and customer requirements.',
		origin: 'India (certification varies by estate/lot).',
		qualityNotes: 'Certificates and scope details provided with samples and contracts when applicable.'
	}
];

const services = [
	'Direct sourcing from Rainforest Alliance aligned estates across Karnataka, Tamil Nadu, and Kerala.',
	'UK-based logistics coordination with bonded warehousing and customs-ready documentation.',
	'Custom roasting partnerships, private-label packaging, and mixed-container planning.',
	'Quality assurance with on-ground cupping labs and moisture, density, and screen grading reports.'
];

const galleryImages = [
	{
		src: '/images/coffee-cups.jpg',
		alt: 'Steaming cappuccino served in stacked white cups beside roasted coffee beans.',
		caption: 'Service-ready cappuccinos highlight the smooth body our UK clients favor.'
	},
	{
		src: '/images/coffee-beans.jpg',
		alt: 'Close-up of roasted coffee beans spilling from a burlap sack.',
		caption: 'Grade-specific green and roasted beans maintain traceability back to estate.'
	}
];
---

<Layout title="Abimanyu 3 Ltd | Indian Coffee Importer" description="Abimanyu 3 Ltd supplies speciality Indian coffee to UK roasters, cafés, and wholesalers with grades including Arabica Plantation AA and Robusta Cherry AB.">
	<main class="min-h-screen bg-[#050a18] text-slate-100">
		<section class="relative isolate overflow-hidden bg-gradient-to-br from-[#132a4a] via-[#0b1d39] to-sky-900/60">
			<div class="absolute inset-0 opacity-20 bg-[radial-gradient(circle_at_top,_rgba(255,255,255,0.15),_transparent_50%)] pointer-events-none"></div>
			<div class="mx-auto flex max-w-6xl flex-col gap-12 px-6 pb-20 pt-28 md:flex-row md:items-center md:gap-16 lg:px-8">
				<div class="md:w-1/2 space-y-6">
					<div class="flex justify-center">
						<img
							src="/images/abimanyu-logo.jpg"
							alt="Abimanyu 3 Ltd logo"
							class="h-48 w-auto rounded-2xl border border-amber-500/40 bg-white/5 object-contain p-4 shadow-xl shadow-amber-500/30 sm:h-64 md:h-72 xl:h-80"
							loading="lazy"
						/>
					</div>
					<p class="uppercase tracking-[0.4em] text-xs text-amber-300/80">UK import · export · wholesale</p>
					<h1 class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl">
						Delivering speciality Indian coffee to the United Kingdom
					</h1>
					<p class="text-lg text-slate-300">
						Abimanyu 3 Ltd sources certified estates across southern India, bringing reliable, flavour-rich coffee to UK roasters, cafés, and wholesalers. Spices, teas, and allied origin produce follow through the same trusted supply chain.
					</p>
					<div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4">
						<a
							href={`mailto:${pricingEmail}`}
							class="inline-flex items-center justify-center rounded-full bg-amber-500 px-6 py-3 text-base font-semibold text-slate-950 shadow-lg shadow-amber-500/40 transition hover:bg-amber-400"
						>
							Request availability sheet
						</a>
						<a
							href="tel:+447341652445"
							class="inline-flex items-center justify-center rounded-full border border-amber-400/60 px-6 py-3 text-base font-semibold text-amber-200 transition hover:border-amber-300 hover:text-amber-100"
						>
							Call +44 7341 652445
						</a>
					</div>
					<p class="text-sm text-slate-400">
						Based in the United Kingdom with fulfilment partners across London, Birmingham, and Felixstowe.
					</p>
				</div>
				<div class="relative md:w-1/2">
					<div class="absolute -inset-6 -z-10 rounded-3xl bg-sky-400/20 blur-3xl"></div>
					<div class="rounded-3xl border border-white/10 bg-white/[0.03] p-6 shadow-2xl shadow-black/40 backdrop-blur">
						<h2 class="text-lg font-semibold text-amber-200">Spotlight Availability</h2>
						<ul class="mt-5 space-y-4 text-sm text-slate-200">
							<li class="flex items-start gap-3">
								<span class="mt-1 inline-block h-2.5 w-2.5 rounded-full bg-sky-400/80"></span>
								<span>
									<strong>Arabica Plantation AA</strong> — fully washed lots, moisture ≤ 12%, SCAA 83+ cupping approvals.
								</span>
							</li>
							<li class="flex items-start gap-3">
								<span class="mt-1 inline-block h-2.5 w-2.5 rounded-full bg-sky-400/80"></span>
								<span>
									<strong>Robusta Cherry AB</strong> — sun-dried, screen 17+, ideal for espresso blends and instant bases.
								</span>
							</li>
							<li class="flex items-start gap-3">
								<span class="mt-1 inline-block h-2.5 w-2.5 rounded-full bg-sky-400/80"></span>
								<span>
									<strong>Sampler Ready · Sealed 1 kg</strong> — vacuum-packed discovery sets couriered within the UK.
								</span>
							</li>
						</ul>
						<p class="mt-6 text-xs leading-relaxed text-slate-400">
							Export documentation, ICO registration, and phyto certificates supplied as standard. Shelf-life and roast profiles available on request.
						</p>
						<div class="mt-6 flex flex-wrap gap-3 text-sm font-semibold">
							<a
								href={`mailto:${pricingEmail}?subject=Catalogue%20Request&body=Hi%20Abimanyu%20team%2C%20please%20send%20the%20latest%20catalogue%20and%20let%20me%20know%20pricing%20for%20my%20target%20volumes.`}
								class="inline-flex items-center gap-2 rounded-full border border-amber-400/60 bg-white/5 px-4 py-2 text-amber-100 transition hover:border-amber-300 hover:bg-amber-400/10 hover:text-amber-50"
							>
								<span class="h-2.5 w-2.5 rounded-full bg-amber-400"></span>
								Email catalogue request
							</a>
							<a
								href="tel:+447341652445"
								class="inline-flex items-center gap-2 rounded-full border border-amber-400/40 px-4 py-2 text-amber-100 transition hover:border-amber-300 hover:bg-white/5 hover:text-amber-50"
							>
								<span class="h-2.5 w-2.5 rounded-full bg-sky-400"></span>
								Call +44 7341 652445
							</a>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="border-t border-white/10 bg-[#0a152a] py-16">
			<div class="mx-auto flex max-w-6xl flex-col gap-10 px-6 lg:flex-row lg:items-center lg:gap-12 lg:px-8">
				<div class="lg:w-2/5 space-y-4">
					<p class="text-xs uppercase tracking-[0.4em] text-amber-300/70">Cup quality in focus</p>
					<h2 class="text-3xl font-bold text-white sm:text-4xl">From cupping table to café counter</h2>
					<p class="text-base text-slate-300">
						Visual benchmarks reassure partners of the cup-ready consistency available through Abimanyu 3 Ltd — whether the requirement is silky arabica for espresso menus or robusta structure for blends.
					</p>
				</div>
				<div class="lg:w-3/5 grid gap-6 sm:grid-cols-2">
					{galleryImages.map((image) => (
						<figure class="group relative overflow-hidden rounded-3xl border border-white/10 bg-white/[0.02] shadow-2xl shadow-black/40">
							<img src={image.src} alt={image.alt} loading="lazy" class="h-64 w-full object-cover transition duration-500 group-hover:scale-105" />
							<figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-slate-950/90 via-slate-950/40 to-transparent px-5 pb-5 pt-16 text-sm text-slate-100">
								{image.caption}
							</figcaption>
						</figure>
					))}
				</div>
			</div>
		</section>

			<section id="catalogue" class="border-t border-white/10 bg-[#0a152a] py-20">
				<div class="mx-auto max-w-6xl px-6 lg:px-8">
					<div class="max-w-3xl">
						<p class="text-xs uppercase tracking-[0.4em] text-amber-300/70">Catalogue</p>
						<h2 class="mt-3 text-3xl font-bold text-white sm:text-4xl">Coffee, spices, and compliance — built for wholesale</h2>
					<p class="mt-4 text-base text-slate-300">
						Products are supplied with documentation and QC support suitable for UK import requirements. Pricing is not listed online and is shared based on grade, order size, and delivery terms.
					</p>
						<div class="mt-8 rounded-2xl border border-amber-400/30 bg-white/[0.03] p-6 text-sm text-slate-200 shadow-xl shadow-black/30">
							<p class="font-semibold text-white">Pricing & catalogue requests</p>
							<p class="mt-2 leading-relaxed text-slate-300">
								For pricing and catalogue requests, please contact us at <a class="text-amber-200 underline decoration-amber-400/40 underline-offset-4" href={`mailto:${pricingEmail}`}>{pricingEmail}</a>.
								Pricing is tailored to your order size, grade, and delivery terms. Prices are not displayed on the website.
							</p>
							<div class="mt-5 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
								<a
									href={cataloguePdfPath}
									class="inline-flex items-center justify-center rounded-full bg-amber-500 px-6 py-3 text-sm font-semibold text-slate-950 shadow-lg shadow-amber-500/35 transition hover:bg-amber-400"
								download
							>
								Download Catalogue
							</a>
							<a
								href={whatsappCatalogueUrl}
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex items-center justify-center rounded-full border border-amber-400/60 px-6 py-3 text-sm font-semibold text-amber-100 transition hover:border-amber-300 hover:bg-white/5 hover:text-amber-50"
							>
								Get Catalogue on WhatsApp
							</a>
						</div>
						<p class="mt-4 text-xs text-slate-400">
							Note: WhatsApp auto-replies are configured in the WhatsApp Business account settings.
						</p>
					</div>
				</div>

				<div class="mt-14">
					<div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
						<div>
							<p class="text-xs uppercase tracking-[0.4em] text-amber-300/70">Product category</p>
							<h3 class="mt-2 text-2xl font-semibold text-white">Coffee Beans (Green & Roasted)</h3>
						</div>
						<p class="text-xs text-slate-400">Origins and QC details are shared per lot.</p>
					</div>
					<div class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
						{coffeeCatalogue.map((coffee) => (
							<article class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-white/5 bg-white/[0.02] p-6 shadow-xl shadow-black/30 transition hover:-translate-y-1 hover:border-amber-400/70">
								{coffee.image && (
									<>
										<img
											src={coffee.image}
											alt={coffee.imageAlt ?? `${coffee.name} coffee background`}
											loading="lazy"
											class="absolute inset-0 h-full w-full object-cover opacity-70 transition duration-500 group-hover:scale-105 group-hover:opacity-80"
										/>
										<div class="absolute inset-0 bg-gradient-to-br from-slate-950/85 via-slate-950/65 to-slate-900/60 transition duration-300 group-hover:from-slate-950/80 group-hover:via-slate-900/60 group-hover:to-slate-900/55"></div>
									</>
								)}
								<div class="relative z-10">
									<div class="flex flex-wrap items-start justify-between gap-2">
										<h4 class="text-xl font-semibold text-white">{coffee.name}</h4>
										<span class="rounded-full border border-amber-400/40 bg-white/5 px-3 py-1 text-xs font-semibold text-amber-100">
											{coffee.format}
										</span>
									</div>
									<dl class="mt-4 space-y-3 text-sm text-slate-200">
										<div>
											<dt class="text-xs font-semibold uppercase tracking-[0.25em] text-slate-300/80">Description</dt>
											<dd class="mt-1 leading-relaxed">{coffee.description}</dd>
										</div>
										<div>
											<dt class="text-xs font-semibold uppercase tracking-[0.25em] text-slate-300/80">Origin</dt>
											<dd class="mt-1 leading-relaxed">{coffee.origin}</dd>
										</div>
										<div>
											<dt class="text-xs font-semibold uppercase tracking-[0.25em] text-slate-300/80">Quality notes</dt>
											<dd class="mt-1 leading-relaxed">{coffee.qualityNotes}</dd>
										</div>
									</dl>
								</div>
							</article>
						))}
					</div>
					<p class="mt-6 text-xs text-slate-400">
						Organic Estate Microlots image credit: Athira96, Chikkamagalur estate — licensed under CC&nbsp;BY-SA&nbsp;4.0 via Wikimedia Commons.
					</p>
				</div>

				<div class="mt-16">
					<div>
						<p class="text-xs uppercase tracking-[0.4em] text-amber-300/70">Product category</p>
						<h3 class="mt-2 text-2xl font-semibold text-white">Spice Portfolio</h3>
						<p class="mt-3 max-w-3xl text-sm text-slate-300">
							Import-ready spices are offered in wholesale formats with lot-level documentation and quality notes shared during sampling and contracting.
						</p>
					</div>
					<div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
						{spiceCatalogue.map((spice) => (
							<article class="rounded-2xl border border-white/5 bg-white/[0.02] p-6 text-sm text-slate-200 shadow-xl shadow-black/25">
								<h4 class="text-lg font-semibold text-white">{spice.name}</h4>
								<dl class="mt-4 space-y-3">
									<div>
										<dt class="text-xs font-semibold uppercase tracking-[0.25em] text-slate-300/80">Description</dt>
										<dd class="mt-1 leading-relaxed">{spice.description}</dd>
									</div>
									<div>
										<dt class="text-xs font-semibold uppercase tracking-[0.25em] text-slate-300/80">Origin</dt>
										<dd class="mt-1 leading-relaxed">{spice.origin}</dd>
									</div>
									<div>
										<dt class="text-xs font-semibold uppercase tracking-[0.25em] text-slate-300/80">Quality notes</dt>
										<dd class="mt-1 leading-relaxed">{spice.qualityNotes}</dd>
									</div>
								</dl>
							</article>
						))}
					</div>
				</div>

				<div class="mt-16">
					<div>
						<p class="text-xs uppercase tracking-[0.4em] text-amber-300/70">Product category</p>
						<h3 class="mt-2 text-2xl font-semibold text-white">Sustainability & Certifications</h3>
						<p class="mt-3 max-w-3xl text-sm text-slate-300">
							Compliance support and sustainability documentation are shared per offer, aligned to the grade, origin, and shipment structure.
						</p>
					</div>
					<div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
						{sustainabilityCatalogue.map((item) => (
							<article class="rounded-2xl border border-white/5 bg-white/[0.02] p-6 text-sm text-slate-200 shadow-xl shadow-black/25">
								<h4 class="text-lg font-semibold text-white">{item.name}</h4>
								<dl class="mt-4 space-y-3">
									<div>
										<dt class="text-xs font-semibold uppercase tracking-[0.25em] text-slate-300/80">Description</dt>
										<dd class="mt-1 leading-relaxed">{item.description}</dd>
									</div>
									<div>
										<dt class="text-xs font-semibold uppercase tracking-[0.25em] text-slate-300/80">Origin</dt>
										<dd class="mt-1 leading-relaxed">{item.origin}</dd>
									</div>
									<div>
										<dt class="text-xs font-semibold uppercase tracking-[0.25em] text-slate-300/80">Quality notes</dt>
										<dd class="mt-1 leading-relaxed">{item.qualityNotes}</dd>
									</div>
								</dl>
							</article>
						))}
					</div>
					</div>
				</div>
			</section>

			<section id="delivery-payment" class="border-t border-white/10 bg-[#0a152a] py-20">
				<div class="mx-auto max-w-6xl px-6 lg:px-8">
					<div class="max-w-3xl">
						<p class="text-xs uppercase tracking-[0.4em] text-amber-300/70">Delivery & Payment</p>
						<h2 class="mt-3 text-3xl font-bold text-white sm:text-4xl">Clear delivery terms and flexible payment options</h2>
						<p class="mt-4 text-base text-slate-300">
							Delivery and payment are agreed per order based on shipment size, timeline, and destination requirements.
						</p>
					</div>

					<div class="mt-10 grid gap-8 lg:grid-cols-2">
						<article class="rounded-2xl border border-white/10 bg-white/[0.03] p-7 text-sm text-slate-200 shadow-xl shadow-black/25">
							<h3 class="text-xl font-semibold text-white">Delivery</h3>
							<ul class="mt-5 space-y-3 text-slate-300">
								<li>
									<strong class="text-slate-100">Samples:</strong> Delivered via DHL/FedEx; courier costs are borne by the buyer unless otherwise agreed.
								</li>
								<li>
									<strong class="text-slate-100">Bulk orders:</strong> Shipped FOB (Free on Board) India or CIF (Cost, Insurance, Freight) to UK ports.
								</li>
								<li>
									<strong class="text-slate-100">Lead time:</strong> 2–4 weeks from order confirmation and receipt of payment or an active Letter of Credit (LOC).
								</li>
								<li>
									<strong class="text-slate-100">Documentation:</strong> Invoice, Packing List, Bill of Lading, FSSAI, IEC, and any buyer-requested certificates.
								</li>
								<li>
									<strong class="text-slate-100">Flexibility:</strong> Buyers can choose air freight (faster, higher cost) or sea freight (economical, longer transit).
								</li>
							</ul>
						</article>

