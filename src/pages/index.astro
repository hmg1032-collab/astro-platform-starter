	},
	{
		id: 'robusta-cherry-ab',
		tierLabel: 'Limited Availability',
		badgeClass: 'bg-sky-900/55 text-sky-100 border-sky-300/30',
		name: 'Robusta Cherry AB',
		blend: 'Sun-dried · Screen 17+',
		flavorNotes: 'Ideal for espresso blends and instant bases.',
