											data-product-id={product.id}
											data-product-name={product.name}
											data-product-grade={product.blend}
											data-price-per-kg={product.pricePerKgGbp}
											class="inline-flex flex-1 items-center justify-center rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-semibold text-slate-950 transition hover:border-amber-400/70 hover:bg-amber-50"
