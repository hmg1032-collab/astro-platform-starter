					const cartWhatsappButton = document.getElementById('cart-whatsapp');

					const formatGbp = (value) =>
						new Intl.NumberFormat('en-GB', { style: 'currency', currency: 'GBP', maximumFractionDigits: 2 }).format(value);

					const readCart = () => {
						try {
							const raw = localStorage.getItem(storageKey);
							const parsed = raw ? JSON.parse(raw) : [];
							return Array.isArray(parsed) ? parsed : [];
						} catch {
							return [];
						}
					};

					const writeCart = (cart) => {
						try {
							localStorage.setItem(storageKey, JSON.stringify(cart));
						} catch {
							// ignore storage failures
						}
					};

					const findSelectedPack = (productId, pricePerKgGbp) => {
						const input = document.querySelector(`input[name="pack-${productId}"]:checked`);
						const grams = input ? Number(input.value) : 250;
						const safeGrams = Number.isFinite(grams) ? grams : 250;

						const inputEl = input instanceof HTMLInputElement ? input : null;
						const explicitPrice = inputEl ? Number(inputEl.dataset.packPrice ?? '') : NaN;
						const priceGbp = Number.isFinite(explicitPrice)
							? explicitPrice
							: Number(((pricePerKgGbp * safeGrams) / 1000).toFixed(2));

						return { grams: safeGrams, priceGbp };
					};

					const cartToSummaryLines = (cart) => {
						const lines = ['Hi Abimanyu team,', '', 'Please confirm availability and pricing for the following items:', ''];
						cart.forEach((item) => {
							lines.push(`- ${item.name} (${item.grade}) — ${item.grams}g — ${formatGbp(item.priceGbp)}`);
						});
						lines.push('', 'Delivery address:', '- Name:', '- Company:', '- Address:', '- Postcode:', '- Phone:', '', 'Thank you.');
						return lines;
					};

					const openCart = () => {
						if (!cartOverlay) return;
						cartOverlay.classList.remove('hidden');
						document.body.style.overflow = 'hidden';
					};

					const closeCart = () => {
						if (!cartOverlay) return;
						cartOverlay.classList.add('hidden');
						document.body.style.overflow = '';
					};

					const renderCart = () => {
						const cart = readCart();
						const itemCount = cart.length;
						if (cartCountEl) cartCountEl.textContent = String(itemCount);

						if (!cartItemsEl || !cartSubtotalEl) return;
						cartItemsEl.innerHTML = '';

						let subtotal = 0;
						cart.forEach((item, index) => {
							subtotal += item.priceGbp;
							const li = document.createElement('li');
							li.className = 'rounded-xl border border-white/10 bg-white/[0.02] p-4';
							li.innerHTML = `
								<div class="flex items-start justify-between gap-4">
									<div>
										<p class="text-sm font-semibold text-white">${item.name}</p>
										<p class="mt-1 text-xs text-slate-300">${item.grade}</p>
										<p class="mt-2 text-xs text-slate-300">${item.grams}g · <span class="font-semibold text-amber-100">${formatGbp(item.priceGbp)}</span></p>
									</div>
									<button type="button" data-remove-index="${index}" class="rounded-lg border border-white/15 bg-white/[0.03] px-3 py-2 text-xs font-semibold text-white hover:bg-white/[0.06]">
										Remove
									</button>
								</div>
							`;
							cartItemsEl.appendChild(li);
						});

						cartSubtotalEl.textContent = formatGbp(subtotal);
					};

					const addToCart = ({ id, name, grade, grams, priceGbp }) => {
						const cart = readCart();
						cart.push({ id, name, grade, grams, priceGbp });
						writeCart(cart);
						renderCart();
						openCart();
					};

					openCartButton?.addEventListener('click', () => {
						renderCart();
						openCart();
					});

					cartOverlay?.addEventListener('click', (event) => {
						const target = event.target;
						if (!(target instanceof HTMLElement)) return;
						if (target.matches('[data-cart-close]')) closeCart();
					});

					clearCartButton?.addEventListener('click', () => {
						writeCart([]);
						renderCart();
					});

					cartItemsEl?.addEventListener('click', (event) => {
						const target = event.target;
						if (!(target instanceof HTMLElement)) return;
						const removeIndexRaw = target.getAttribute('data-remove-index');
						if (!removeIndexRaw) return;
						const removeIndex = Number(removeIndexRaw);
						if (!Number.isInteger(removeIndex)) return;

						const cart = readCart();
						cart.splice(removeIndex, 1);
						writeCart(cart);
						renderCart();
					});

					cartEmailButton?.addEventListener('click', () => {
						const cart = readCart();
						if (!pricingEmail || cart.length === 0) return;
						const subject = 'Order request (samples / bulk quote)';
						const body = cartToSummaryLines(cart).join('\n');
						window.location.href = `mailto:${pricingEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
					});

					cartWhatsappButton?.addEventListener('click', () => {
						const cart = readCart();
						if (!whatsappNumber || cart.length === 0) return;
						const text = cartToSummaryLines(cart).join('\n');
						const url = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(text)}`;
						window.open(url, '_blank', 'noopener,noreferrer');
					});

					document.addEventListener('click', (event) => {
						const target = event.target;
						if (!(target instanceof HTMLElement)) return;

						const addButton = target.closest('[data-action="add-to-cart"]');
						if (addButton instanceof HTMLElement) {
							const productId = addButton.dataset.productId ?? '';
							const productName = addButton.dataset.productName ?? '';
							const productGrade = addButton.dataset.productGrade ?? '';
							const pricePerKgGbp = Number(addButton.dataset.pricePerKg ?? '0');
							if (!productId || !Number.isFinite(pricePerKgGbp) || pricePerKgGbp <= 0) return;

							const { grams, priceGbp } = findSelectedPack(productId, pricePerKgGbp);
							addToCart({ id: productId, name: productName, grade: productGrade, grams, priceGbp });
							return;
						}

						const sampleLink = target.closest('[data-action="request-sample"]');
						if (sampleLink instanceof HTMLAnchorElement) {
							const productId = sampleLink.dataset.productId ?? '';
							const productName = sampleLink.dataset.productName ?? '';
							const productGrade = sampleLink.dataset.productGrade ?? '';
							const pricePerKgGbp = Number(sampleLink.dataset.pricePerKg ?? '0');
							if (!productId || !pricingEmail || !Number.isFinite(pricePerKgGbp) || pricePerKgGbp <= 0) return;

							event.preventDefault();
							const { grams, priceGbp } = findSelectedPack(productId, pricePerKgGbp);

							const subject = `Sample request: ${productName} — ${productGrade} (${grams}g)`;
							const bodyLines = [
								'Hi Abimanyu team,',
								'',
								'Please send a sample for:',
								`- Product: ${productName} (${productGrade})`,
								`- Pack size: ${grams}g`,
								`- Catalogue price: ${formatGbp(priceGbp)}`,
								'',
								'Delivery address:',
								'- Name:',
								'- Company:',
								'- Address:',
								'- Postcode:',
								'- Phone:',
								'',
								'Thank you.'
							];

							window.location.href = `mailto:${pricingEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(
								bodyLines.join('\n')
							)}`;
						}
					});

					renderCart();

					const packagingImages = {
						jar: '/images/samples/coffee-jar-real.png',
						vacuum: '/images/festive/vacuum-coffee-samples.svg',
						pouch: '/images/offers/mid-tier-packet.jpg',
						bag: '/images/coffee-beans.jpg'
					};

					document.addEventListener('change', (event) => {
						const target = event.target;
						if (!(target instanceof HTMLInputElement) || target.type !== 'radio' || !target.name.startsWith('pack-')) return;

						const productId = target.name.replace('pack-', '');
						const imageType = target.dataset.imageType;
						const imgEl = document.getElementById(`img-${productId}`);

						if (imgEl && imageType && packagingImages[imageType]) {
							imgEl.src = packagingImages[imageType];
						}
					});
				</script>

				<script type="module" is:inline>
					const countdownContainers = document.querySelectorAll('[data-countdown]');

					const pad2 = (value) => String(value).padStart(2, '0');

					const updateCountdown = (container) => {
						const deadlineRaw = container.getAttribute('data-deadline') ?? '';
						const deadlineMs = Date.parse(deadlineRaw);
						if (!Number.isFinite(deadlineMs)) return;

						const nowMs = Date.now();
						const diffMs = deadlineMs - nowMs;

						const values = {
							days: 0,
							hours: 0,
							mins: 0,
							secs: 0
						};

						if (diffMs > 0) {
							const totalSeconds = Math.floor(diffMs / 1000);
							values.days = Math.floor(totalSeconds / 86400);
							values.hours = Math.floor((totalSeconds % 86400) / 3600);
							values.mins = Math.floor((totalSeconds % 3600) / 60);
							values.secs = Math.floor(totalSeconds % 60);
						} else {
							container.setAttribute('data-expired', 'true');
						}

						container.querySelectorAll('[data-countdown-value]').forEach((el) => {
							const unit = el.getAttribute('data-countdown-value');
							if (!unit || !(unit in values)) return;
							const value = values[unit];
							el.textContent = unit === 'days' ? String(value) : pad2(value);
						});
					};

					const tick = () => countdownContainers.forEach((container) => updateCountdown(container));

					tick();
					window.setInterval(tick, 1000);
				</script>



