					</div>
				</div>

				<div class="mt-16">
					<div>
						<p class="text-xs uppercase tracking-[0.4em] text-amber-300/70">Product category</p>
						<h3 class="mt-2 text-2xl font-semibold text-white">Sustainability & Certifications</h3>
						<p class="mt-3 max-w-3xl text-sm text-slate-300">
							Compliance support and sustainability documentation are shared per offer, aligned to the grade, origin, and shipment structure.
						</p>
					</div>
					<div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
						{sustainabilityCatalogue.map((item) => (
							<article class="rounded-2xl border border-white/5 bg-white/[0.02] p-6 text-sm text-slate-200 shadow-xl shadow-black/25">
								<h4 class="text-lg font-semibold text-white">{item.name}</h4>
								<dl class="mt-4 space-y-3">
									<div>
										<dt class="text-xs font-semibold uppercase tracking-[0.25em] text-slate-300/80">Description</dt>
										<dd class="mt-1 leading-relaxed">{item.description}</dd>
									</div>
									<div>
										<dt class="text-xs font-semibold uppercase tracking-[0.25em] text-slate-300/80">Origin</dt>
										<dd class="mt-1 leading-relaxed">{item.origin}</dd>
									</div>
									<div>
										<dt class="text-xs font-semibold uppercase tracking-[0.25em] text-slate-300/80">Quality notes</dt>
										<dd class="mt-1 leading-relaxed">{item.qualityNotes}</dd>
									</div>
								</dl>
							</article>
						))}
					</div>
