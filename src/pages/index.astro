									<div>
										<dt class="text-xs font-semibold uppercase tracking-[0.25em] text-slate-300/80">Quality notes</dt>
										<dd class="mt-1 leading-relaxed">{spice.qualityNotes}</dd>
									</div>
								</dl>
							</article>
