---
const logoSrc = "/horse-eye-logo.png"; // <-- make sure this file is inside /public
---

<div class="logo-container">
  <a href="/" class="logo-link" aria-label="Abhimanyu 3">
    <!-- Logo image only -->
    <img src={logoSrc} alt="Abhimanyu 3 logo" class="logo-image" />
  </a>
</div>

<style>
  .logo-container {
    display: flex;
    align-items: center;
    justify-content: center; /* centers the logo in header */
  }

  .logo-link {
    text-decoration: none;
    display: flex;
    align-items: center;
  }

  .logo-image {
    height: 80px; /* adjust size as needed */
    width: auto;
    display: block;
  }
</style>
