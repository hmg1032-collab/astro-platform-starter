---
const brandName = "Abhimanyu 3";
const tagline = "Your wholesale partner in purity";
---

<div class="logo-container">
  <a href="/" class="logo-link">
    <img src="/horse-eye-logo.png" alt={brandName} class="logo-image" />
    <div class="logo-text">
      <h1 class="brand-name">{brandName}</h1>
      <p class="tagline">{tagline}</p>
    </div>
  </a>
</div>

<style>
  .logo-container {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .logo-link {
    text-decoration: none;
    color: inherit;
    display: flex;
    align-items: center;
  }

  .logo-image {
    height: 64px;
    width: auto;
  }

  .brand-name {
    margin: 0;
    font-size: 2.4rem;
    font-weight: 900;
    color: white;
    letter-spacing: 1px;
  }

  .tagline {
    margin: 0;
    font-size: 1.2rem;
    color: white;
    font-style: italic;
    font-weight: 500;
  }
</style>
