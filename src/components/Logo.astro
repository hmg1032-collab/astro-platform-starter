---
const logoSrc = "/horse-eye-logo.png"; // Your logo image in public/
const tagline = "Your wholesale partner in purity";
const backgroundImage = "/coffee-background.jpg"; // Add this image to public/
---

<div class="logo-section">
  <a href="/" class="logo-link" aria-label="Abhimanyu 3">
    <img src={logoSrc} alt="Abhimanyu 3 logo" class="logo-image" />
  </a>
  <p class="tagline">{tagline}</p>
</div>

<style>
  .logo-section {
    background-color: indigo;
    background-image: url({backgroundImage});
    background-size: cover;
    background-position: center;
    padding: 2rem;
    text-align: center;
    border-bottom: 2px solid #fff;
  }

  .logo-link {
    display: inline-block;
  }

  .logo-image {
    height: 80px;
    width: auto;
    display: block;
    margin: 0 auto;
  }

  .tagline {
    margin-top: 1rem;
    font-size: 1.2rem;
    color: white;
    font-style: italic;
    font-weight: 500;
  }
</style>
