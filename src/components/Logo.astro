---
const logoSrc = "/abhimanyu-logo.png"; // Rename your uploaded image to this and place in public/
const tagline = "Your wholesale partner in purity";
---

<div class="logo-section">
  <a href="/" class="logo-link" aria-label="Abhimanyu 3">
    <img src={logoSrc} alt="Abhimanyu 3 logo" class="logo-image" />
  </a>
  <p class="tagline">{tagline}</p>
</div>

<style>
  .logo-section {
    background-color: indigo;
    background-image: url(/coffee-background.jpg); /* Optional: coffee beans background */
    background-size: cover;
    background-position: center;
    padding: 2rem;
    text-align: center;
  }

  .logo-image {
    height: 120px; /* Adjust height as needed */
    width: auto;
    max-width: 100%;
    display: block;
    margin: 0 auto;
  }

  .tagline {
    margin-top: 1rem;
    font-size: 1.2rem;
    color: white;
    font-style: italic;
    font-weight: 500;
  }
</style>
