<style>
  .header {
    background-color: indigo;
    padding: 1rem;
    color: white;
  }

  .container {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .nav ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem;
    padding: 0;
    margin-top: 1rem;
  }

  .nav a {
    color: white;
    text-decoration: none;
    font-weight: 600;
    font-size: 1rem;
  }

  .nav a:hover {
    text-decoration: underline;
    color: #ffcc00;
  }
</style>
