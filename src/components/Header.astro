---
import Logo from "../Logo.astro";
---

<header class="header">
  <div class="container">
    <div class="logo">
      <Logo />
    </div>
    <nav class="nav">
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/products">Our Products</a></li>
        <li><a href="/mythic-origins">Mythic Origins</a></li>
        <li><a href="/import-guide">Import Guide</a></li>
        <li><a href="/compliance">Compliance</a></li>
